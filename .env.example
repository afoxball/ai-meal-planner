# Environment variables example
# Copy this to .env and fill in your values

# Required for production - generate a secure random key
SECRET_KEY=your-secret-key-here

# Database URL (Render will provide this automatically)
# For local development, you can use SQLite (leave blank) or PostgreSQL
DATABASE_URL=

# Google Gemini API Key (required for meal plan generation)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Flask debug mode (set to 'true' only for local development)
FLASK_DEBUG=false
